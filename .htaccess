RewriteEngine On
# HTTPS erzwingen und www auf Hauptdomain umleiten (301)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://tech-saar.de%{REQUEST_URI} [R=301,L]

# Caching. Ohne diese Angaben raten Browser die Haltbarkeit selbst (grob 10 %
# des Dateialters) und zeigen nach einem Deploy stundenlang den alten Stand -
# auch Kunden, die eine Demo vorher schon einmal offen hatten.
# Die IfModule-Klammer sorgt dafuer, dass fehlende Module hier nichts kaputt
# machen: die Zeilen werden dann einfach ignoriert statt einen 500 auszuloesen.
<IfModule mod_headers.c>
  # HTML jedes Mal kurz beim Server rueckfragen. Unveraendert = 304, ein paar
  # hundert Byte, da ein ETag vorhanden ist.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Bilder, Schriften, Stylesheets und Skripte aendern sich nur mit einem Deploy
  # und duerfen lange liegen bleiben - das macht Wiederbesuche schneller.
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff2|woff|css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
